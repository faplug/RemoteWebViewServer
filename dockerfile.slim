# Slim variant of the upstream server image: builds the TypeScript server from
# source and installs ONLY the Chromium headless shell instead of the full
# Playwright bundle (chromium + firefox + webkit, ~1.5 GB).
#
# Upstream: https://github.com/strange-v/RemoteWebViewServer
# Fork:     https://github.com/faplug/RemoteWebViewServer

FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl jq socat \
 && rm -rf /var/lib/apt/lists/*

# Browser + its system libraries only for the headless shell we actually run.
RUN npm install --no-audit --no-fund --no-save playwright@1.64.0 \
 && npx playwright install --with-deps --only-shell chromium \
 && rm -rf /var/lib/apt/lists/* /root/.npm

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY self-test ./self-test
COPY run.sh /run.sh
COPY reload_on_start.mjs /reload_on_start.mjs
COPY static.mjs /static.mjs
RUN chmod +x /run.sh

EXPOSE 8080 8081 9221 18080
CMD ["/run.sh"]
